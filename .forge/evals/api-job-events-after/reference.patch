+function jobEventsPage(res: http.ServerResponse, root: string, id: string, url: URL): void {
+  if (!validJobId(id) || !exists(path.join(jobDir(root, id), 'job.json'))) return jsonStatus(res, 404, { error: validJobId(id) ? `no job ${id}` : 'no such job' });
+  const after = countParam(url, 'after');
+  if (after === null) return jsonStatus(res, 400, { error: 'after must be a non-negative integer: the next of the page before' });
+  const limit = countParam(url, 'limit');
+  if (limit === null || limit === 0) return jsonStatus(res, 400, { error: `limit must be an integer from 1 (at most ${EVENTS_PAGE_MAX} are returned)` });
+  const events = readEvents(root, id);
+  const start = Math.min(after ?? 0, events.length);
+  const page = events.slice(start, start + Math.min(limit ?? EVENTS_PAGE, EVENTS_PAGE_MAX));
+  return json(res, { events: page, next: start + page.length, total: events.length } satisfies JobEventsPage);
