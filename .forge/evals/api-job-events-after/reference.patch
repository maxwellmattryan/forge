+test("pages a job's events at /api/jobs/<id>/events by event count", async () => {
+  const repo = tempRepo();
+  const env = { ...process.env, FORGE_ROOT: repo.dir };
+  const bin = path.resolve(import.meta.dirname, '..', 'bin', 'forge');
+  const forge = (...args) => JSON.parse(execFileSync(process.execPath, [bin, ...args], { cwd: repo.dir, encoding: 'utf8', env }));
+  forge('init', 'write');
+  const job = forge('job', 'new', '--title', 'Long log');
+  const file = path.join(repo.dir, job.dir, 'events.jsonl');
+  const lines = Array.from({ length: 1200 }, (_, i) => JSON.stringify({ v: 1, ts: new Date(0).toISOString(), type: 'note', text: `n${i}` }));
+  // A torn or foreign line is not an event, so it is neither returned nor counted.
+  fs.appendFileSync(file, lines.slice(0, 600).join('\n') + '\nnot json\n' + lines.slice(600).join('\n') + '\n');
+  const total = 1201;
+  const { server, url } = await startServer(repo.dir, { port: 0 });
+  const port = Number(new URL(url).port);
+  const page = async (q: string) => {
+    const r = await get(port, `/api/jobs/${job.id}/events${q}`);
+    return { status: r.status, body: JSON.parse(r.body.toString('utf8')) };
+  };
+  try {
+    const first = await page('');
+    assert.equal(first.status, 200);
+    assert.equal(first.body.events.length, 200, 'the default page size');
+    assert.equal(first.body.events[0].type, 'created');
+    assert.deepEqual([first.body.next, first.body.total], [200, total]);
+    const capped = await page('?after=1&limit=5000');
+    assert.equal(capped.body.events.length, 1000, 'limit is capped at 1000');
+    assert.equal(capped.body.events[0].text, 'n0');
+    assert.equal(capped.body.next, 1001);
+    const rest = await page(`?after=${capped.body.next}&limit=1000`);
+    assert.deepEqual(rest.body.events.map((e) => e.text), Array.from({ length: 200 }, (_, i) => `n${1000 + i}`));
+    assert.equal(rest.body.next, total);
+    assert.deepEqual((await page('?after=99999')).body, { events: [], next: total, total });
+    for (const q of ['?after=-1', '?after=1e3', '?after=', '?after=0x10', '?limit=0', '?limit=1.0', '?limit=+5'])
+      assert.equal((await page(q)).status, 400, q);
+    assert.equal((await page('?limit=1')).body.events.length, 1);
+    const unknown = await get(port, '/api/jobs/no-such-job/events');
+    assert.equal(unknown.status, 404);
+    assert.deepEqual(JSON.parse(unknown.body.toString('utf8')), { error: 'no job no-such-job' });
+    assert.equal((await get(port, '/api/jobs/_inbox/events')).status, 404);
+    assert.equal((await get(port, `/api/jobs/${job.id}/events`, `evil.example:${port}`)).status, 421);
+  } finally {
+    server.close();
+    repo.cleanup();
+  }
+});
