+const isMap = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object' && !Array.isArray(v);
+
+/** Every dotted key of `obj`, sections and their children alike. A list is one key: its items are data, not keys. */
+export function configKeys(obj: unknown, prefix = ''): string[] {
+  if (!isMap(obj)) return [];
+  return Object.entries(obj).flatMap(([k, v]) => {
+    const key = prefix ? `${prefix}.${k}` : k;
+    return [key, ...configKeys(v, key)];
+  });
+}
+
+/** Optimal string alignment distance: insertions, deletions, substitutions and adjacent swaps. */
+function editDistance(a: string, b: string): number {
+  const d = Array.from({ length: a.length + 1 }, (_, i) => Array.from({ length: b.length + 1 }, (_, j) => (i === 0 ? j : j === 0 ? i : 0)));
+  for (let i = 1; i <= a.length; i++) {
+    for (let j = 1; j <= b.length; j++) {
+      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
+      d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
+      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
+    }
+  }
+  return d[a.length][b.length];
+}
+
+/**
+ * Up to three of `candidates` within a quarter of `key`'s length (at least one edit, at most three) of it,
+ * closest first, ties in alphabetical order. Nothing close gives [].
+ */
+export function closestKeys(key: string, candidates: Iterable<string>): string[] {
+  // Capped, so a long nested key doesn't pull in a sibling that merely shares its prefix.
+  const limit = Math.min(3, Math.max(1, Math.floor(key.length / 4)));
+  return [...new Set(candidates)]
+    .map((c) => ({ c, d: editDistance(key, c) }))
+    .filter((x) => x.d > 0 && x.d <= limit)
+    .sort((x, y) => x.d - y.d || (x.c < y.c ? -1 : x.c > y.c ? 1 : 0))
+    .slice(0, 3)
+    .map((x) => x.c);
+}
+
+/** The usage error for a key that is not a config key, offering the closest of `candidates`. */
+export function unknownKeyError(key: string, candidates: Iterable<string>): ConfigSetError {
+  const suggestions = closestKeys(key, candidates);
+  const tail = suggestions.length ? `did you mean ${suggestions.join(', ')}?` : 'see docs/CONFIG.md';
+  const e = new ConfigSetError('unknown', `unknown config key "${key}"; ${tail}`);
+  e.suggestions = suggestions;
+  return e;
+}
+
+/** Maps whose defaults list only some of the names a repo may use: `checkout` steps name any `commands.*` entry. */
+const USER_NAMED = new Set(['commands']);
+
