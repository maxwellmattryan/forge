+    const inConfig = isMap(c) && Object.hasOwn(c, k);
+    const inDefaults = isMap(d) && Object.hasOwn(d, k);
+    if (!inConfig && !inDefaults) return true;
+    c = inConfig ? (c as Record<string, unknown>)[k] : undefined;
+    d = inDefaults ? (d as Record<string, unknown>)[k] : undefined;
+  }
+  return false;
+}
