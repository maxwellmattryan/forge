+ * the user's, so an absent one there is just unset and reads as null.
+ */
+export function isUnknownKey(config: Config, key: string): boolean {
+  if (!key) return false;
+  let c: unknown = config;
+  let d: unknown = base;
+  let at = '';
+  for (const k of key.split('.')) {
+    if (USER_NAMED.has(at) || Array.isArray(c) || Array.isArray(d) || d === undefined || (isMap(d) && !Object.keys(d).length)) return false;
