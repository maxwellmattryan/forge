@@ -151,4 +151,31 @@ describe('a job driven by step alone', { concurrency: 4 }, () => {
       s.cleanup();
     }
   });
+
+  test('a spec edited after its approval waits for a fresh one', async () => {
+    const s = await scratch({ pipeline: { specApproval: 'always' } });
+    try {
+      const { id } = await s.f('job', 'new', '--title', 'Add a hello script', '--body', 'Add hello.sh that prints hi.');
+      const steps = { n: 0 };
+      assert.equal((await drive(s, id, steps)).waitingOn, 'spec-approval');
+      await s.f('job', 'human', id, 'approve-spec', '--note', 'ok');
+      const approval = readEvents(s.root, id).findLast((e) => e.type === 'human');
+      assert.match(String(approval?.specHash), /^[0-9a-f]{64}$/, 'the approval pins the content it saw');
+      await s.f('job', 'set', id, '--state', 'running');
+      const spec = path.join(jobDir(s.root, id), 'spec.md');
+      fs.appendFileSync(spec, '\n- also print bye\n');
+      let a = await s.f('job', 'step', id);
+      assert.equal(a.rule, 'SP8', JSON.stringify(a));
+      await s.raw(...a.command);
+      a = await s.f('job', 'step', id);
+      assert.equal(a.waitingOn, 'spec-approval');
+      assert.match(a.tell, /spec changed since approval: .*spec\.md/);
+      await s.f('job', 'human', id, 'approve-spec', '--note', 'ok again');
+      await s.f('job', 'set', id, '--state', 'running');
+      a = await s.f('job', 'step', id);
+      assert.equal(a.rule, 'SP6', JSON.stringify(a));
+    } finally {
+      s.cleanup();
+    }
+  });
 });
