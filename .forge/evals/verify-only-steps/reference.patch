+test('--only runs the named steps in their groups, and a partial pass never verifies the HEAD', () => {
+  const x = s();
+  x.configure({
+    commands: { build: x.step('build'), a: x.step('a', '--needs build --meet b'), b: x.step('b', '--needs build --meet a'), c: x.step('c') },
