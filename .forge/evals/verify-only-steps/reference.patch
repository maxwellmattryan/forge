+  const bad = x.verify(j.id, {}, ['--only', 'b,nope']);
+  assert.equal(bad.status, 2);
+  assert.match(bad.stderr, /"nope" is not a configured verify step; the steps are: build, a, b, c/);
+  assert.deepEqual(x.commands(j.id), [], 'nothing ran');
+  assert.equal(fs.existsSync(path.join(j.dir, 'verify')), false, 'nothing recorded');
+  assert.equal(x.verify(j.id, {}, ['--only']).status, 2, 'a bare --only names no step');
+
+  // b still meets a only if they run as one group: b alone would time out waiting for a.
+  const r = x.verify(j.id, {}, ['--only', 'b,a,build']);
