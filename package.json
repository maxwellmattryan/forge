{
  "name": "@maxwellmattryan/forge",
  "version": "0.7.0",
  "description": "Forge: a lightweight, self-improving software factory for AI coding agents: orchestrator, agent roster, worktrees, PR sync, trackers, evals and a live dashboard.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "forge": "bin/forge"
  },
  "files": [
    "bin",
    "lib",
    "dashboard",
    "agents",
    "reviewers",
    "skills",
    "hooks",
    "templates",
    "docs",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build:dashboard": "vite build --config dashboard/vite.config.mjs && node dashboard/build-stamp.mjs",
    "check:dashboard": "svelte-check --tsconfig dashboard/tsconfig.json --fail-on-warnings"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwellmattryan/forge.git"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "forge",
    "software-factory",
    "orchestration",
    "worktrees"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.1.18",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.1.18",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  }
}
