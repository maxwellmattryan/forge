{
  "name": "@maxwellmattryan/forge",
  "version": "0.18.8",
  "description": "Forge: a lightweight, self-improving software factory for AI coding agents: orchestrator, agent roster, worktrees, PR sync, trackers, evals and a live dashboard.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "forge": "bin/forge"
  },
  "files": [
    "bin",
    "lib",
    "dashboard",
    "agents",
    "reviewers",
    "skills",
    "hooks",
    "templates",
    "docs",
    "assets"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "build:dashboard": "vite build --config dashboard/vite.config.mjs && node dashboard/build-stamp.mjs",
    "check:dashboard": "{ [ dashboard/.svelte-check/manifest.json -nt package-lock.json ] && [ dashboard/.svelte-check/manifest.json -nt dashboard/svelte.config.mjs ]; } || rm -rf dashboard/.svelte-check; svelte-check --workspace dashboard --tsconfig tsconfig.json --fail-on-warnings --incremental",
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/forge/tsc-engine.tsbuildinfo && tsc -p test/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/forge/tsc-test.tsbuildinfo",
    "docs:commands": "node scripts/docs-commands.ts",
    "dev": "node scripts/dev.ts",
    "dev:claude": "node scripts/dev-claude.ts",
    "release": "node scripts/release.ts",
    "release:check": "node scripts/release-check.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwellmattryan/forge.git"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "forge",
    "software-factory",
    "orchestration",
    "worktrees"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.13",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
