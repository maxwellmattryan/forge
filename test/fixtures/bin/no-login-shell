#!/bin/sh
# The suite's $SHELL (test/helpers.ts). Configured commands run as `/bin/sh -c` (commandShell) and
# never reach this script; Forge runs `$SHELL -lc <command>` only under commandEnv.loginShell: true
# and when `forge dash` captures the login shell's PATH. This runs those in the caller's own shell
# without -l, because a login profile (nvm, for one) can cost a second per run and reorder PATH, and
# no test needs one.
if [ "$1" = -lc ]; then
  shift
  exec "${FORGE_TEST_SHELL:-/bin/sh}" -c "$@"
fi
exec "${FORGE_TEST_SHELL:-/bin/sh}" "$@"
