# Global git config for the test suite (see test/helpers.ts): scratch repos must not
# depend on the host, e.g. a commit.gpgsign that needs a gpg agent. Background maintenance after a
# commit (git maintenance run --auto --detach) races repoTemplate's directory copy, so it is off.
[user]
	name = Test
	email = test@example.com
[core]
	autocrlf = false
[commit]
	gpgsign = false
[tag]
	gpgsign = false
[init]
	defaultBranch = main
[maintenance]
	auto = false
[gc]
	auto = 0
