{
  "description": "Every human gate, one job each",
  "jobs": [
    {
      "key": "spec",
      "title": "Approve the widget spec",
      "files": { "spec.md": "# Widget\n\n## Acceptance criteria\n- [ ] AC1 — the widget renders\n" },
      "steps": [["job", "set", "{id}", "--stage", "spec", "--state", "waiting", "--waiting-on", "spec-approval", "--reason", "spec ready"]]
    },
    {
      "key": "split",
      "title": "Split the billing overhaul",
      "steps": [["job", "set", "{id}", "--stage", "plan", "--state", "waiting", "--waiting-on", "split-approval", "--reason", "three jobs proposed"]]
    },
    {
      "key": "link",
      "title": "Link the search fix to its issue",
      "steps": [["job", "set", "{id}", "--stage", "spec", "--state", "waiting", "--waiting-on", "issue-link", "--reason", "no issue yet"]]
    },
    {
      "key": "input",
      "title": "Answer the cache question",
      "files": { "questions.md": "1. Should the cache survive a restart?\n" },
      "steps": [["job", "set", "{id}", "--stage", "build", "--state", "waiting", "--waiting-on", "input", "--reason", "one question"]]
    },
    {
      "key": "escalation",
      "title": "Escalated auth change",
      "steps": [["job", "set", "{id}", "--stage", "decide", "--state", "waiting", "--waiting-on", "escalation", "--reason", "touches auth"]]
    },
    {
      "key": "infra",
      "title": "Run the bucket migration",
      "files": { "runbook.md": "1. Create the bucket.\n" },
      "steps": [["job", "set", "{id}", "--stage", "build", "--state", "waiting", "--waiting-on", "infra", "--reason", "runbook ready"]]
    },
    {
      "key": "conflicts",
      "title": "Resolve the router conflicts",
      "steps": [["job", "set", "{id}", "--stage", "integrate", "--state", "waiting", "--waiting-on", "conflicts", "--reason", "two files conflict"]]
    },
    {
      "key": "rounds",
      "title": "Rounds ran out on the parser",
      "steps": [["job", "set", "{id}", "--stage", "review", "--state", "waiting", "--waiting-on", "rounds-exhausted", "--reason", "three rounds"]]
    },
    {
      "key": "budget",
      "title": "Over budget on the importer",
      "steps": [["job", "set", "{id}", "--stage", "build", "--state", "waiting", "--waiting-on", "budget", "--reason", "token cap reached"]]
    },
    {
      "key": "human",
      "title": "Check the protected paths",
      "steps": [["job", "set", "{id}", "--stage", "verify", "--state", "waiting", "--waiting-on", "human", "--reason", "protected path changed"]]
    },
    {
      "key": "held",
      "title": "Hold the workflow push",
      "steps": [["job", "set", "{id}", "--stage", "pr", "--state", "waiting", "--waiting-on", "human", "--reason", "push held: CI config changes: .github/workflows/ci.yml [ci 0123456789abcdef]"]]
    },
    {
      "key": "shelved",
      "title": "Shelved billing rewrite",
      "steps": [
        ["job", "set", "{id}", "--stage", "decide", "--state", "waiting", "--waiting-on", "escalation", "--reason", "touches billing"],
        ["job", "shelve", "{id}", "--reason", "waiting on the billing owner"]
      ]
    }
  ],
  "expect": {
    "pipeline": [
      "Approve the widget spec",
      "Check the protected paths",
      "Spec approval",
      "Split approval",
      "Issue to link",
      "Question for you",
      "Escalated",
      "Infra steps",
      "Merge conflicts",
      "Review rounds exhausted",
      "Budget exceeded",
      "Human check",
      "Shelved"
    ],
    "project": ["@project.empty"],
    "issues": ["@issues.empty"],
    "agents": ["@agents.noRunning", "@agents.noSessions"],
    "office": ["@foreman.office.title", "@statusbar.foreman.offTitle", "@foreman.office.noMandates", "@foreman.office.noDirectives"],
    "foreman": ["@foreman.title", "@foreman.chats.emptyTitle"],
    "analytics": ["@analytics.jobs", "@analytics.noUsage"],
    "evals": ["@evals.empty"],
    "drawer": { "job": "spec", "text": ["Spec approval", "spec ready", "@dock.label"] }
  }
}
