{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["lib/**/*", "hooks/**/*", "test/types-parity.ts"]
}
